generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

model Rol {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  descripcion   String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id             Int            @id @default(autoincrement())
  nombre         String
  correo         String         @unique
  contrasenaHash String
  estado         EstadoRegistro @default(ACTIVO)
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  sesiones SesionUsuario[]

  @@map("usuarios")
}

model SesionUsuario {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiraEn  DateTime
  creadoEn  DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("sesiones_usuario")
}

model Categoria {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  descripcion   String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  productos Producto[]

  @@map("categorias")
}

model Producto {
  id            Int            @id @default(autoincrement())
  nombre        String
  descripcion   String?
  codigoBarra   String?        @unique
  precioCompra  Decimal        @db.Decimal(10, 2)
  precioVenta   Decimal        @db.Decimal(10, 2)
  stockActual   Int            @default(0)
  stockMinimo   Int            @default(0)
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  detallesCompra        DetalleCompra[]
  detallesVenta         DetalleVenta[]
  movimientosInventario MovimientoInventario[]

  @@map("productos")
}

model Cliente {
  id            Int            @id @default(autoincrement())
  nombre        String
  ciNit         String?
  telefono      String?
  direccion     String?
  correo        String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  ventas Venta[]

  @@map("clientes")
}

model Proveedor {
  id            Int            @id @default(autoincrement())
  nombre        String
  nit           String?
  telefono      String?
  direccion     String?
  correo        String?
  contacto      String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  compras Compra[]

  @@map("proveedores")
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

model Compra {
  id            Int            @id @default(autoincrement())
  numeroCompra  String         @unique
  fechaCompra   DateTime       @default(now())
  total         Decimal        @db.Decimal(10, 2)
  observacion   String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  proveedorId Int
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  detalles    DetalleCompra[]
  movimientos MovimientoInventario[]

  @@map("compras")
}

model DetalleCompra {
  id             Int      @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  creadoEn       DateTime @default(now())

  compraId Int
  compra   Compra @relation(fields: [compraId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_compra")
}

model MovimientoInventario {
  id             Int                      @id @default(autoincrement())
  tipoMovimiento TipoMovimientoInventario
  cantidad       Int
  stockAnterior  Int
  stockNuevo     Int
  motivo         String?
  referencia     String?
  creadoEn       DateTime                 @default(now())

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  compraId Int?
  compra   Compra? @relation(fields: [compraId], references: [id])
  
  ventaId Int?
  venta   Venta? @relation(fields: [ventaId], references: [id])

  @@map("movimientos_inventario")
}

enum TipoComprobante {
  NOTA_VENTA
}

model Venta {
  id            Int            @id @default(autoincrement())
  numeroVenta   String         @unique
  fechaVenta    DateTime       @default(now())
  total         Decimal        @db.Decimal(10, 2)
  observacion   String?
  estado        EstadoRegistro @default(ACTIVO)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  detalles    DetalleVenta[]
  movimientos MovimientoInventario[]
  comprobante Comprobante?

  @@map("ventas")
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  creadoEn       DateTime @default(now())

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@map("detalles_venta")
}

model Comprobante {
  id                Int             @id @default(autoincrement())
  numeroComprobante String          @unique
  tipoComprobante   TipoComprobante @default(NOTA_VENTA)
  fechaEmision      DateTime        @default(now())
  total             Decimal         @db.Decimal(10, 2)
  clienteNombre     String
  estado            EstadoRegistro  @default(ACTIVO)
  creadoEn          DateTime        @default(now())
  actualizadoEn     DateTime        @updatedAt

  ventaId Int   @unique
  venta   Venta @relation(fields: [ventaId], references: [id])

  @@map("comprobantes")
}
